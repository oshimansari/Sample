        "def selection_sort(arr):\n",
        "    n = len(arr)\n",
        "\n",
        "    for i in range(n):\n",
        "        # 1. Assume the current position 'i' holds the smallest value\n",
        "        min_idx = i\n",
        "\n",
        "        # 2. Look at the rest of the list to find a smaller number\n",
        "        for j in range(i + 1, n):\n",
        "            if arr[j] < arr[min_idx]:\n",
        "                min_idx = j\n",
        "\n",
        "        # 3. Swap the smallest one we found with the first unsorted item\n",
        "        arr[i], arr[min_idx] = arr[min_idx], arr[i]\n",
        "\n",
        "    return arr\n",
        "\n",
        "# --- Output ---\n",
        "my_list = [29, 10, 14, 37, 13]\n",
        "print(\"Sorted List:\", selection_sort(my_list))"
