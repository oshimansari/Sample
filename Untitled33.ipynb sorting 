        "def insertion_sort(arr):\n",
        "    for i in range(1, len(arr)):\n",
        "        key = arr[i]\n",
        "        j = i - 1\n",
        "        # Move items that are bigger than 'key' to the right\n",
        "        while j >= 0 and arr[j] > key:\n",
        "            arr[j + 1] = arr[j]\n",
        "            j -= 1\n",
        "        # Place the 'key' in its new home\n",
        "        arr[j + 1] = key\n",
        "    return arr\n",
        "\n",
        "# Test it\n",
        "print(insertion_sort([9, 5, 1, 4, 3]))"
