        "def bubble_sort(arr):\n",
        "    # Repeat the process for every item in the list\n",
        "    for i in range(len(arr)):\n",
        "\n",
        "        # Compare neighbors from start to end\n",
        "        for j in range(len(arr) - 1):\n",
        "\n",
        "            # If the left one is bigger, swap them\n",
        "            if arr[j] > arr[j + 1]:\n",
        "                arr[j], arr[j + 1] = arr[j + 1], arr[j]\n",
        "\n",
        "    return arr\n",
        "my_list = [5, 1, 4, 2, 8]\n",
        "sorted_list = bubble_sort(my_list)\n",
        "\n",
        "print(\"Final Sorted List:\", sorted_list)"
      ]
